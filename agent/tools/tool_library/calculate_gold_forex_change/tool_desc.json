{
  "tool_name": "calculate_gold_forex_change",
  "tool_role": "R4: Derived Metrics / Calculations",
  "domain": [
    "economy",
    "forex"
  ],
  "task_type": "computation",
  "input_semantics": [
    {
      "field": "start_date",
      "semantic_type": "dsl_slot",
      "description": "TIME.START",
      "required": true
    },
    {
      "field": "end_date",
      "semantic_type": "dsl_slot",
      "description": "TIME.END",
      "required": true
    }
  ],
  "output_semantics": [
    {
      "field": "指标名称",
      "semantic_type": "value",
      "description": "The name of the indicator, such as '黄金储备 (万盎司)' or '国家外汇储备 (亿美元)'."
    },
    {
      "field": "开始时间",
      "semantic_type": "value",
      "description": "The start time of the period, formatted as 'YYYY-MM'."
    },
    {
      "field": "开始数值",
      "semantic_type": "value",
      "description": "The starting value of the indicator, with units in ten thousand ounces for gold reserves and billion USD for national forex reserves."
    },
    {
      "field": "结束时间",
      "semantic_type": "value",
      "description": "The end time of the period, formatted as 'YYYY-MM'."
    },
    {
      "field": "结束数值",
      "semantic_type": "value",
      "description": "The ending value of the indicator, with units in ten thousand ounces for gold reserves and billion USD for national forex reserves."
    },
    {
      "field": "变化百分比(%)",
      "semantic_type": "value",
      "description": "The percentage change over the period."
    }
  ],
  "produces": [
    "economic_indicator_change"
  ],
  "consumes": [
    "gold_reserve_data",
    "forex_reserve_data"
  ],
  "error_model": {
    "observability": "return_schema",
    "error_types": [
      "invalid_parameter",
      "internal_exception"
    ],
    "error_surface": "return_field",
    "notes": "Handles exceptions internally and returns error messages in the return schema."
  },
  "examples": {
    "parameter_template": {
      "start_date": "2023-01",
      "end_date": "2023-06"
    },
    "return_shape_example": {
      "指标名称": "国家外汇储备 (亿美元)",
      "开始时间": "2023-01",
      "开始数值": 3200.5,
      "结束时间": "2023-06",
      "结束数值": 3150.75,
      "变化百分比(%)": "-1.55%",
      "error": {
        "type": "invalid_parameter",
        "message": "The start_date must be earlier than the end_date."
      }
    }
  },
  "description": "SELECT CHANGE_PCT, START_VALUE, END_VALUE\nFROM FOREX\nWHERE INDICATOR = <黄金储备 | 国家外汇储备>\n  AND TIME BETWEEN start_date AND end_date",
  "tool_alternative": [
    "get_gold_forex_reserves_on_date",
    "get_gold_forex_reserves"
  ],
  "tool_dependencies": [
    "get_gold_forex_reserves_on_date",
    "get_gold_forex_reserves"
  ],
  "tool_related": [
    "calculate_lpr_rate_change",
    "calculate_m2_supply_rate_change",
    "get_china_macro_pro",
    "get_forex_price_on_date",
    "get_gold_forex_reserves",
    "get_gold_forex_reserves_on_date",
    "get_lpr_rate",
    "get_lpr_rate_on_date",
    "get_m2_supply_rate",
    "get_m2_supply_rate_on_date",
    "get_ppi_rate_on_date",
    "get_ppi_yearly_by_quarters"
  ]
}