{
  "tool_name": "get_current_latest_value",
  "tool_role": "R2: Time-indexed Raw Market / Macro Data",
  "domain": [
    "forex"
  ],
  "task_type": "retrieval",
  "input_semantics": [
    {
      "field": "base",
      "semantic_type": "dsl_slot",
      "description": "IDENTIFIER.BASE",
      "required": true
    },
    {
      "field": "currency",
      "semantic_type": "dsl_slot",
      "description": "IDENTIFIER.CURRENCY",
      "required": true
    },
    {
      "field": "column_label",
      "semantic_type": "dsl_slot",
      "description": "IDENTIFIER.COLUMN_LABEL",
      "enum": [
        "rates",
        "date",
        "base"
      ],
      "required": true
    },
    {
      "field": "symbol",
      "semantic_type": "dsl_slot",
      "description": "IDENTIFIER.SYMBOL",
      "required": false
    }
  ],
  "output_semantics": [
    {
      "field": "base_currency",
      "semantic_type": "value",
      "description": "The base currency code used in the query."
    },
    {
      "field": "target_currency",
      "semantic_type": "value",
      "description": "The target currency code for which the latest exchange rate is provided."
    },
    {
      "field": "data_type",
      "semantic_type": "metadata",
      "description": "The type of data returned, which is 'latest_realtime'."
    },
    {
      "field": "metric_name",
      "semantic_type": "metadata",
      "description": "The name of the metric or column label from which the value is extracted."
    },
    {
      "field": "value",
      "semantic_type": "value",
      "description": "The latest exchange rate value for the specified target currency."
    },
    {
      "field": "rate_last_updated",
      "semantic_type": "metadata",
      "description": "The timestamp of when the exchange rate was last updated, in ISO 8601 format."
    }
  ],
  "produces": [
    "exchange_rate"
  ],
  "consumes": [
    "currency_code"
  ],
  "error_model": {
    "observability": "both",
    "error_types": [
      "invalid_parameter",
      "internal_exception"
    ],
    "error_surface": "exception",
    "notes": "Handles exceptions with try-except blocks."
  },
  "examples": {
    "parameter_template": {
      "base": "USD",
      "currency": "CNY",
      "column_label": "rates",
      "symbol": "AUD,CNY"
    },
    "return_shape_example": {
      "base_currency": "USD",
      "target_currency": "CNY",
      "data_type": "latest_realtime",
      "metric_name": "rates",
      "value": 6.45,
      "rate_last_updated": "2023-10-05T14:30:00Z",
      "error": {
        "type": "invalid_parameter",
        "message": "The currency code 'XYZ' is not supported."
      }
    }
  },
  "description": "SELECT FOREX.LATEST.<rates|date|base>\nFROM FOREX\nWHERE BASE_CURRENCY = <base>\n  AND TARGET_CURRENCY = <currency>\n  [AND SYMBOL = <symbol>]",
  "tool_alternative": [
    "convert_currency_amount",
    "get_currency_history_value",
    "get_currency_rate_on_date",
    "get_current_latest_value",
    "get_fx_spot_quote_value"
  ],
  "tool_dependencies": [],
  "tool_related": [
    "convert_currency_amount",
    "get_currency_history_value",
    "get_currency_rate_on_date",
    "get_fx_spot_quote_value",
    "get_monthly_avg_currency_rate",
    "get_rmb_central_parity_rate_change"
  ]
}