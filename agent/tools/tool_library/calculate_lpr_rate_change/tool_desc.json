      "field": "指标名称",
      "semantic_type": "value",
      "description": "The name of the interest rate type."
    },
    {
      "field": "开始时间",
      "semantic_type": "value",
      "description": "The start date, format 'YYYY-MM-DD'."
    },
    {
      "field": "开始数值(%)",
      "semantic_type": "value",
      "description": "The starting value, in percentage."
    },
    {
      "field": "结束时间",
      "semantic_type": "value",
      "description": "The end date, format 'YYYY-MM-DD'."
    },
    {
      "field": "结束数值(%)",
      "semantic_type": "value",
      "description": "The ending value, in percentage."
    },
    {
      "field": "变化(基点)",
