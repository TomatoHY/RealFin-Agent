{
  "tool_name": "get_gold_forex_reserves_on_date",
  "tool_role": "R2: Time-indexed Raw Market / Macro Data",
  "domain": [
    "economy",
    "forex"
  ],
  "task_type": "retrieval",
  "input_semantics": [
    {
      "field": "indicator_name",
      "semantic_type": "dsl_slot",
      "description": "INDICATOR.NAME",
      "enum": [
        "黄金储备",
        "国家外汇储备"
      ],
      "required": true
    },
    {
      "field": "query_date",
      "semantic_type": "dsl_slot",
      "description": "TIME.RANGE",
      "required": true
    }
  ],
  "output_semantics": [
    {
      "field": "indicator_name",
      "semantic_type": "value",
      "description": "The name of the queried indicator."
    },
    {
      "field": "query_date",
      "semantic_type": "value",
      "description": "The month queried by the user in 'YYYY-MM' format."
    },
    {
      "field": "actual_date",
      "semantic_type": "value",
      "description": "The date of the actual data in 'YYYY-MM' format."
    },
    {
      "field": "value",
      "semantic_type": "value",
      "description": "The numerical value of the indicator."
    }
  ],
  "produces": [
    "economic_indicator_value"
  ],
  "consumes": [
    "economic_indicator_request"
  ],
  "error_model": {
    "observability": "return_schema",
    "error_types": [
      "invalid_parameter",
      "internal_exception"
    ],
    "error_surface": "return_field",
    "notes": "The tool uses try-except blocks to handle exceptions internally."
  },
  "examples": {
    "parameter_template": {
      "indicator_name": "黄金储备",
      "query_date": "2023-09"
    },
    "return_shape_example": {
      "indicator_name": "黄金储备",
      "query_date": "2023-09",
      "actual_date": "2023-09",
      "value": 1200.5,
      "error": {
        "type": "invalid_parameter",
        "message": "The indicator name provided is not valid."
      }
    }
  },
  "description": "SELECT RESERVE_VALUE\nFROM FOREX\nWHERE INDICATOR = <黄金储备|国家外汇储备>\n  AND TIME = <YYYY-MM-DD>",
