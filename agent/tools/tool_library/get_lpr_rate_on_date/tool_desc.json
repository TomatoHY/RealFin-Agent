{
  "tool_name": "get_lpr_rate_on_date",
  "tool_role": "R2: Time-indexed Raw Market / Macro Data",
  "domain": [
    "economy"
  ],
  "task_type": "retrieval",
  "input_semantics": [
    {
      "field": "indicator_name",
      "semantic_type": "dsl_slot",
      "description": "INDICATOR.NAME",
      "enum": [
        "LPR1Y",
        "LPR5Y",
        "RATE_1",
        "RATE_2"
      ],
      "required": true
    },
    {
      "field": "query_date",
      "semantic_type": "dsl_slot",
      "description": "TIME.RANGE",
      "required": true
    }
  ],
  "output_semantics": [
    {
      "field": "indicator_name",
      "semantic_type": "identifier",
      "description": "The name of the interest rate indicator queried."
    },
    {
      "field": "query_date",
      "semantic_type": "time_range",
      "description": "The date for which the interest rate was queried."
    },
    {
      "field": "actual_date",
      "semantic_type": "time_range",
      "description": "The actual date of the closest available interest rate data."
    },
    {
      "field": "value",
      "semantic_type": "value",
      "description": "The interest rate value for the specified indicator and date."
    }
  ],
  "produces": [
    "interest_rate_data"
  ],
  "consumes": [
    "interest_rate_query"
  ],
  "error_model": {
    "observability": "return_schema",
    "error_types": [
      "invalid_parameter",
      "empty_result"
    ],
    "error_surface": "return_field",
    "notes": "Handles errors internally with try-except blocks."
  },
  "examples": {
    "parameter_template": {
      "indicator_name": "LPR_1Y",
      "query_date": "2023-10-15"
    },
    "return_shape_example": {
      "indicator_name": "LPR_1Y",
      "query_date": "2023-10-15",
      "actual_date": "2023-10-15",
      "value": 3.65,
      "error": {
        "type": "empty_result",
        "message": "No data available for the specified date."
      }
    }
  },
  "description": "SELECT LPR_RATE\nFROM ECONOMY\nWHERE INDICATOR = <LPR1Y|LPR5Y|RATE_1|RATE_2>\n  AND DATE = <query_date>",
