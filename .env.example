# Copy to .env in the repository root, then set your provider credentials.
# Run commands from the repository root so APISettings can read .env.

# Used with --location realfin. Supply an OpenAI-compatible endpoint
# that provides the model identifiers in agent/models/model_factory.py.
REALFIN_API_KEY=
REALFIN_API_BASE=https://your-openai-compatible-endpoint.example/v1

# Used with --location openai. The selected model must exist at this endpoint.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Currency tools read this directly from the process environment, not .env.
# Export CURRENCY_API_KEY in your shell before running currency tasks.
CURRENCY_API_KEY=
